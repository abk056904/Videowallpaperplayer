# Build output
build/
out/
*.user
*.suo
.vs/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Logs / runtime state (never commit personal media or test clips)
*.log
config.json.bak

# Scratch / temp (e.g. ffmpeg-synthesized test clips)
scratch/
tmp/

# Packaging output (regenerable via package.ps1)
dist/

# FFmpeg SDK (downloaded, not source-tracked — only headers + libs + DLLs needed)
ext/ffmpeg/**/*.html
ext/ffmpeg/**/*.css
ext/ffmpeg/**/doc/
ext/ffmpeg/**/examples/
ext/ffmpeg/**/presets/
ext/ffmpeg/**/ffplay*
ext/ffmpeg/**/ffprobe*
ext/ffmpeg/**/ffmpeg.exe
ext/ffmpeg/**/*.def
ext/ffmpeg/**/*.pc
ext/ffmpeg/**/*.zip
ext/ffmpeg/**/Changelog
ext/ffmpeg/**/RELEASE
ext/ffmpeg/**/VERSION

